LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
PORT=3000

# Google Gemini vision identification. Preferred provider.
GEMINI_API_KEY=

# Pioneer AI (Fastino Labs). Used only when GEMINI_API_KEY is unset. Its
# published catalogue has no vision-capable model, so this path may 403.
PIONEER_API_KEY=
# Optional override, defaults to https://api.pioneer.ai
PIONEER_BASE_URL=

# Optional generic vision webhook, used only when PIONEER_API_KEY is unset.
VISION_IDENTIFIER_URL=
VISION_IDENTIFIER_TOKEN=
