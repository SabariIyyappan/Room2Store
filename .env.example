LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
PORT=3000

# Pioneer AI (Fastino Labs). Preferred: it hosts Gemini and the hackathon
# credits live there. Key format: pio_sk_...
PIONEER_API_KEY=
# Optional override, defaults to https://api.pioneer.ai/v1
PIONEER_BASE_URL=

# Model ids are namespaced and must match the account's catalogue exactly.
# Confirm them with: npm run pioneer:probe
VISION_PRIMARY_MODEL=google/gemini-3.1-flash-lite
VISION_FALLBACK_MODEL=google/gemini-3.5-flash-lite
VISION_HARD_CASE_MODEL=pioneer/auto

# Direct-to-Google escape hatch, used only when PIONEER_API_KEY is unset.
GEMINI_API_KEY=

# Optional generic vision webhook, used only when PIONEER_API_KEY is unset.
VISION_IDENTIFIER_URL=
VISION_IDENTIFIER_TOKEN=

# ── Engineer B: orchestration, compliance, infra ──────────────────────────

# Shared application settings
NODE_ENV=development
DATABASE_URL=postgresql://room2store:room2store@localhost:5432/room2store

# Band remote-agent credentials
# Create each remote agent in Band's dashboard. API keys are shown once: paste
# them only into your local .env file and never commit or share that file.
BAND_API_BASE_URL=https://app.band.ai
BAND_ENABLED=false
ROOM2STORE_API_BASE_URL=http://localhost:3000
BAND_FLOW_COORDINATOR_AGENT_ID=
BAND_FLOW_COORDINATOR_API_KEY=
BAND_ROOM_CATALOGER_AGENT_ID=
BAND_ROOM_CATALOGER_API_KEY=
BAND_PRICING_RESEARCHER_AGENT_ID=
BAND_PRICING_RESEARCHER_API_KEY=
BAND_PRICE_SETTER_AGENT_ID=
BAND_PRICE_SETTER_API_KEY=
BAND_SAFETY_REVIEWER_AGENT_ID=
BAND_SAFETY_REVIEWER_API_KEY=
BAND_STORE_PUBLISHER_AGENT_ID=
BAND_STORE_PUBLISHER_API_KEY=
BAND_SALES_CONCIERGE_AGENT_ID=
BAND_SALES_CONCIERGE_API_KEY=
BAND_SETTLEMENT_CLERK_AGENT_ID=
BAND_SETTLEMENT_CLERK_API_KEY=

# Other integration credentials (leave blank locally until each is configured)
RENDER_API_KEY=
GITHUB_TOKEN=

# B10 store builder — GitHubRepoPublisher (GITHUB_TOKEN above + GITHUB_OWNER,
# the user/org repos are created under) and RenderStaticSiteDeployer
# (RENDER_API_KEY above + RENDER_OWNER_ID, your Render workspace id from
# dashboard.render.com/settings). Leave either pair blank to run against the
# local, network-free publisher/deployer instead.
GITHUB_OWNER=
RENDER_OWNER_ID=

# Superserve — sandbox-per-campaign lifecycle (B8). Leave SUPERSERVE_API_KEY
# blank to run the orchestrator's in-memory sandbox stub instead.
# SUPERSERVE_BASE_URL is optional — the SDK derives the right region from
# the API key when it's omitted.
SUPERSERVE_BASE_URL=
SUPERSERVE_API_KEY=

# Pioneer AI — hosted GLiNER2-PII model (B7 PII scrubbing). Leave
# PIONEER_API_KEY blank to run compliance's local regex scrubber instead.
PIONEER_API_URL=https://api.pioneer.ai/v1
# (same key as above - one PIONEER_API_KEY serves both vision and PII)

# Render Workflows — the DAG's own deploy (B9). RENDER_API_KEY (above) also
# triggers task runs on a deployed workflow service via @renderinc/sdk once
# B12 links this repo's workflows/ package on Render; RENDER_WORKFLOW_SERVICE_SLUG
# names that service. Leave both blank to only run the DAG through
# `pnpm workflow:demo` / the pipeline-cli, in process.
RENDER_WORKFLOW_SERVICE_SLUG=room2store-workflows

# B9 stage integrations — the sockets Engineer A's perception/pricing
# services and Engineer C's commerce service plug into (B10's store builder
# is called directly, not through a URL — see GITHUB_OWNER/RENDER_OWNER_ID
# above). Leave blank to run the DAG against @room2store/contracts fixtures
# instead (same fixture-mode fallback as Band/Pioneer/Superserve).
PERCEPTION_SERVICE_URL=
PRICING_SERVICE_URL=
COMMERCE_SERVICE_URL=

# Pricing. Terac is MCP-only for now, so whoever runs the study posts the
# result to POST /api/listings/:id/price with this shared token.
PRICING_ADMIN_TOKEN=
# Filled in once Terac API keys and webhooks are created; unused until then.
TERAC_API_KEY=
TERAC_WEBHOOK_SECRET=

# Public URL of the storefront, linked in the seller's confirmation message.
PUBLIC_WEB_URL=

# Terac panel pricing. Base URL defaults to https://terac.com/api/external/v2
TERAC_API_URL=
