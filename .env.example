# Shared application settings
NODE_ENV=development
DATABASE_URL=postgresql://room2store:room2store@localhost:5432/room2store

# Band remote-agent credentials
# Create each remote agent in Band's dashboard. API keys are shown once: paste
# them only into your local .env file and never commit or share that file.
BAND_API_BASE_URL=https://app.band.ai
BAND_ENABLED=false
ROOM2STORE_API_BASE_URL=http://localhost:3000
BAND_FLOW_COORDINATOR_AGENT_ID=
BAND_FLOW_COORDINATOR_API_KEY=
BAND_ROOM_CATALOGER_AGENT_ID=
BAND_ROOM_CATALOGER_API_KEY=
BAND_PRICING_RESEARCHER_AGENT_ID=
BAND_PRICING_RESEARCHER_API_KEY=
BAND_PRICE_SETTER_AGENT_ID=
BAND_PRICE_SETTER_API_KEY=
BAND_SAFETY_REVIEWER_AGENT_ID=
BAND_SAFETY_REVIEWER_API_KEY=
BAND_STORE_PUBLISHER_AGENT_ID=
BAND_STORE_PUBLISHER_API_KEY=
BAND_SALES_CONCIERGE_AGENT_ID=
BAND_SALES_CONCIERGE_API_KEY=
BAND_SETTLEMENT_CLERK_AGENT_ID=
BAND_SETTLEMENT_CLERK_API_KEY=

# Other integration credentials (leave blank locally until each is configured)
RENDER_API_KEY=
GITHUB_TOKEN=
SUPERSERVE_API_URL=
SUPERSERVE_API_KEY=
PII_MODEL_API_URL=
PII_MODEL_API_KEY=
