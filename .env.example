LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
PORT=3000

# Pioneer AI (Fastino Labs). Preferred: it hosts Gemini and the hackathon
# credits live there. Key format: pio_sk_...
PIONEER_API_KEY=
# Optional override, defaults to https://api.pioneer.ai/v1
PIONEER_BASE_URL=

# Model ids are namespaced and must match the account's catalogue exactly.
# Confirm them with: npm run pioneer:probe
VISION_PRIMARY_MODEL=google/gemini-3.1-flash-lite
VISION_FALLBACK_MODEL=google/gemini-3.5-flash-lite
VISION_HARD_CASE_MODEL=pioneer/auto

# Direct-to-Google escape hatch, used only when PIONEER_API_KEY is unset.
GEMINI_API_KEY=

# Optional generic vision webhook, used only when PIONEER_API_KEY is unset.
VISION_IDENTIFIER_URL=
VISION_IDENTIFIER_TOKEN=
